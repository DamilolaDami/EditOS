<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Most Info.plist keys come from build settings:
	  - INFOPLIST_KEY_NSMicrophoneUsageDescription
	  - INFOPLIST_KEY_NSSpeechRecognitionUsageDescription
	  - GENERATE_INFOPLIST_FILE = YES (merges this file with the
	    generated one at build time).
	Anything macOS-specific that the build-setting generators don't
	cover lives here.
	-->

	<!-- Finder / Launchpad category. Surfaces the app under the Video
	     section of category-aware browsers. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>

	<!-- Shown in Finder "Get Info" and the macOS About dialog. -->
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Damilola. MIT License.</string>

	<!-- Screen recording: ScreenCaptureKit shows the system TCC prompt
	     on first use; this is the user-facing string in that dialog. -->
	<key>NSCameraUsageDescription</key>
	<string>EditOS uses the camera to record alongside your screen for tutorials and reaction videos.</string>

	<!-- Sparkle (auto-update). The public key verifies update payload
	     signatures so an attacker can't push a malicious binary down
	     the appcast feed. The matching private key lives only in the
	     maintainer's login keychain and is used by sign_update at
	     release time. The feed URL points at a GitHub Pages-served
	     appcast.xml in docs/. -->
	<key>SUPublicEDKey</key>
	<string>RLUgv+FtXX+Loh1mipzBEyjP2OzcwueavTk6lO38XzI=</string>
	<key>SUFeedURL</key>
	<string>https://damiloladami.github.io/EditOS/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
