<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    EditOS — third-party service credentials.

    Setup:
      1. Copy this file to `Secrets.plist` in the same directory.
      2. Add `Secrets.plist` to the EditOS Xcode target via
         File → Add Files… (so it's copied into the app bundle).
      3. Fill in your keys below. Leave a value empty to disable that
         integration — the corresponding panel will gray itself out
         instead of crashing.

    Both keys are optional. The app builds and runs fine without them;
    you just won't see GIPHY stickers or Freesound search results.

    Get keys:
      - GIPHY  : https://developers.giphy.com/dashboard/  (free)
      - Freesound : https://freesound.org/apiv2/apply/   (free, OAuth)
    -->

    <key>GIPHY_API_KEY</key>
    <string></string>

    <key>FREESOUND_API_TOKEN</key>
    <string></string>
</dict>
</plist>
