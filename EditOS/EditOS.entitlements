<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Capabilities that live OUTSIDE Xcode's build-setting generators
	(ENABLE_APP_SANDBOX, ENABLE_RESOURCE_ACCESS_AUDIO_INPUT, etc., which
	are emitted as their canonical com.apple.security.* keys at build
	time). Anything new should be added here only if it isn't already
	covered by a build-setting flag.
	-->

	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.damioffice.EditOS</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array/>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.security.network.client</key>
	<true/>

	<!--
	Sparkle 2 in a sandboxed app launches its installer XPC service
	via a mach lookup. The sandbox blocks that lookup by default,
	surfacing in the UI as "An error occurred while launching the
	installer." Adding `org.sparkle-project.InstallerLauncher` to the
	temporary-exception list unblocks the install flow. The downloader
	XPC service runs in-session (JoinExistingSession=true) so it
	doesn't need its own exception.
	Reference: https://sparkle-project.org/documentation/sandboxing/
	-->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>org.sparkle-project.InstallerLauncher</string>
	</array>
</dict>
</plist>
